{
  "name": "potentialpaper-paper-map",
  "version": "0.8.0",
  "private": true,
  "description": "A PotentialPaper plugin: every paper on a map, near the papers most like it, from a signal set.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && git diff --exit-code -- dist"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "d3-force": "^3.0.0",
    "umap-js": "^1.4.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
